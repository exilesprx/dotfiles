{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "opencode/mimo-v2.6-flash-free",
      "color": "secondary",
    },
    "plan": {
      "model": "opencode/big-pickle",
      "color": "primary",
    },
    "reviewer": {
      "description": "Read-only code reviewer and security auditor",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "color": "#ff6b6b",
      "system": "Review the git diff for logic errors, edge cases, missing unit tests, and security vulnerabilities. List findings in order of severity."
    },
    "q-a": {
      "description": "Codebase-wide comprehension and architectural Q&A",
      "mode": "subagent",
      "model": "opencode/laguna-s-2.1-free",
      "color": "#4ecdc4",
    },
  },
}
